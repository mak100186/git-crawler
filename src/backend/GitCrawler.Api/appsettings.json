{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "GitHub": {
    "Token": "",
    "DiscoveryPageSize": 50,
    "DiscoveryLookbackDays": 2,
    "DiscoveryMinimumStars": 5
  },
  "LmStudio": {
    "BaseUrl": "http://localhost:1234",
    "Model": "gitcrawler-summarizer",
    "MaxTokens": 300,
    "MaxDetailedTokens": 500
  },
  "Summarization": {
    "MinimumScore": 40,
    "BatchSize": 20,
    "MaxSummaryLength": 220,
    "MaxDetailedSummaryLength": 900,
    "MaxReadmeCharacters": 6000
  },
  "Scoring": {
    "ScoreHistoryRetentionCount": 10,
    "BatchSize": 500
  },
  "Trends": {
    "PeriodDays": 1
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "EnableSsl": true,
    "FromAddress": ""
  },
  "Digest": {
    "TopN": 10,
    "RecipientEmail": ""
  },
  "Hangfire": {
    "CrawlerCronSchedule": "0 3 * * *",
    "SummarizationCronSchedule": "0 * * * *",
    "DigestCronSchedule": "0 6 * * *"
  }
}
