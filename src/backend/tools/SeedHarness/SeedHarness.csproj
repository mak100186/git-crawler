<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin EF Core packages to match GitCrawler.Api (10.0.10) - Npgsql 10.0.3 transitively
         pulls 10.0.4 without these direct pins, causing version-conflict warnings. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GitCrawler.Api\GitCrawler.Api.csproj" />
  </ItemGroup>

</Project>
