## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Node / Angular (src/frontend)
node_modules/
dist/
.angular/
npm-debug.log*

# Angular production build copied into the host's static file root at publish/Docker-build time
# (see src/backend/GitCrawler.Api/GitCrawler.Api.csproj's CopyAngularApp target and
# src/backend/Dockerfile) - generated, not committed.
src/backend/**/wwwroot/*
!src/backend/**/wwwroot/.gitkeep

# graphify tool cache - stray/regeneratable AST+semantic cache, not the intentional output. The
# real deliverables (graph.html, graph.json, GRAPH_REPORT.md, manifest.json) live in the
# repo-root graphify-out/ and are committed there; this rule catches any accidental duplicate
# cache dir created elsewhere (e.g. src/graphify-out/, src/backend/graphify-out/ - both produced
# at different times depending on the cwd graphify was invoked from) while still allowing the
# root one through.
**/graphify-out/
!/graphify-out/

# PostgreSQL data directory (docker-compose.yml bind mount) - runtime data, not source; persists
# across `docker compose down` on purpose, but must never be committed.
data/postgres/*
!data/postgres/.gitkeep

# Vitest's rerun-failed-tests cache - regenerated on every test run, not source.
test-results/

# Exported design-tool brief - a dropped-in bundle (compiled JS, generated manifests), not
# something meant to be diffed/hand-edited. Kept on disk locally; docs referencing its path
# (handoff.md, changelog.md, project-management.md, test-cases.md) still resolve for anyone
# who has it, they just won't get it from a fresh clone.
docs/design-briefs/
