  "cards": [
    {
      "dot": "cyan",
      "title": "Ingest and score",
      "items": [
        "GraphQL-first GitHub access with REST fallback (ADR-004)",
        "Polly retry and rate-limit handling (ADR-018)",
        "Score from independently weighted signals, not stars alone"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pipeline shape",
      "items": [
        "Each stage runs on its own Hangfire schedule (ADR-009)",
        "Each stage is a Wolverine command handler — vertical slice + CQRS (ADR-015)",
        "Stages never call each other; PostgreSQL is the handoff"
      ]
    },
    {
      "dot": "violet",
      "title": "Local AI and delivery",
      "items": [
        "Llama 3.2 3B via host-installed LM Studio, no cloud AI cost (ADR-001, ADR-016)",
        "One .NET 10 process serves the API and the built dashboard (ADR-008)",
        "The daily digest sends independently of the crawl pipeline"
      ]
    }
