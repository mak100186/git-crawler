# Copy this file to `.env` (git-ignored) before running `make up`. This file is the single source
# of truth for every default below - neither docker-compose.yml, the Makefile, nor Program.cs's
# bare `dotnet run` bridge re-hardcodes a fallback copy of any of these values, so there's exactly
# one place to change if a default ever needs to change. Every variable here except the SMTP/digest
# block at the bottom is required by docker-compose.yml and the Makefile's `check-env` - both fail
# loudly (pointing back at this file) if a required one is missing, rather than silently limping
# along on a guessed value. Only POSTGRES_PASSWORD, GITHUB_TOKEN, and the two SMTP credential
# fields ship blank below - everything else already has a working default, so a plain
# `cp .env.example .env` plus POSTGRES_PASSWORD and GITHUB_TOKEN is enough to run `make up`.
# See docs/setup.md for the full walkthrough, including how to create the GitHub token below.

# PostgreSQL 18.4 (ADR-014) connection details for the `postgres` Compose service. PORT is the
# host-published port (docker-compose.yml's `ports:` mapping); both a local DB client and
# Program.cs's bare `dotnet run` bridge connect through it. The app container itself always talks
# to postgres:5432 over the internal Compose network, regardless of this value.
POSTGRES_DB=gitcrawler
POSTGRES_USER=gitcrawler
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# GitHub Personal Access Token (PAT-based auth per the F-001 spike's stated assumption and
# NFR-002 - "GitHub API token stored via environment/secrets configuration"). Not used by any
# feature yet in this scaffold (F-005 Crawler is where it's first consumed) but wired through so
# the container fails fast if it's missing rather than silently running without it.
# How to create one: docs/setup.md §1 (fine-grained, Public Repositories read-only access - no
# scopes are needed just to read public repo data, only the authenticated rate limit boost).
GITHUB_TOKEN=

# LM Studio (ADR-016 - host-installed, not containerized). PORT is what both the Makefile and
# Program.cs's bare `dotnet run` bridge use to reach LM Studio's local server - defaults to LM
# Studio's own default port, only change if you've configured LM Studio differently. IDENTIFIER is
# the fixed alias `make up` assigns the loaded model via `lms load --identifier`; it's what the app
# sends as "model" in LM Studio API calls (LmStudio:Model config) and rarely needs to change. MODEL
# is the catalog model `make up` loads under that identifier - llama-3.2-3b-instruct (ADR-017,
# supersedes ADR-013's original Gemma 4 E4B pin, which wasted 65-86% of its output budget on
# internal reasoning before the visible summary - see
# docs/spikes/f-002-lm-studio-throughput-benchmark.md §9-§10) is confirmed present in LM Studio's
# catalog on the target machine as of 2026-08-01 - re-check with `lms ls` if it's missing or you
# switch machines.
LMSTUDIO_PORT=1234
LMSTUDIO_IDENTIFIER=gitcrawler-summarizer
LMSTUDIO_MODEL=llama-3.2-3b-instruct

# Daily digest email (F-013). Defaults below point at the Mailpit container `make up` starts
# alongside the app - the digest is composed and delivered for real, it just lands in Mailpit's web
# UI at http://localhost:8025/ instead of a mailbox. That's the useful default: it's inspectable,
# needs no credentials, and never mails anyone by accident. `mailpit` is the Compose service's DNS
# name; localhost would be the app container itself, not Mailpit.
#
# To send to a real mailbox instead, set SMTP_HOST/SMTP_PORT/SMTP_ENABLE_SSL to your provider,
# SMTP_USERNAME/SMTP_PASSWORD to its credentials (an app password, not the account password), and
# both addresses below to real ones.
#
# These are the only variables here that docker-compose.yml passes through unguarded (no
# ${VAR:?...}), since blank is legitimate for all of them: blank SMTP_HOST, SMTP_FROM_ADDRESS, or
# DIGEST_RECIPIENT_EMAIL means the 06:00 UTC job runs, logs a warning, and skips. Blank SMTP_PORT
# and SMTP_ENABLE_SSL are different again - SmtpEmailSender falls back to 587 and true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=false
SMTP_FROM_ADDRESS=digest@localhost
DIGEST_RECIPIENT_EMAIL=digest@localhost
